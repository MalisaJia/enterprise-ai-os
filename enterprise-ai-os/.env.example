# =============================================================================
# Enterprise AI OS — 自研组件环境变量模板
# 用法: cp .env.example .env  然后填入真实值。.env 不要提交到 Git。
# =============================================================================

# -----------------------------------------------------------------------------
# 全局
# -----------------------------------------------------------------------------
ENV=dev                          # dev | staging | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=json                  # json | text
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# PostgreSQL (含 pgvector 扩展) —— RAG 向量 / 记忆 / 工作流状态
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aios
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=aios
# 各服务使用的 schema（同库不同 schema，便于独立演进）
PG_SCHEMA_RAG=rag
PG_SCHEMA_MEMORY=memory
PG_SCHEMA_WORKFLOW=workflow
# 完整连接串（服务优先读这个；留空则由上面字段拼装）
DATABASE_URL=postgresql://aios:change-me-in-production@postgres:5432/aios

# -----------------------------------------------------------------------------
# Redis —— 限流计数 / 熔断状态 / 任务队列 / 缓存
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_DB_GATEWAY=0
REDIS_DB_RAG=1
REDIS_DB_MEMORY=2
REDIS_DB_WORKFLOW=3

# -----------------------------------------------------------------------------
# 向量后端选择: pgvector | milvus
# -----------------------------------------------------------------------------
VECTOR_BACKEND=pgvector
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_RAG=aios_documents
MILVUS_COLLECTION_MEMORY=aios_memories

# -----------------------------------------------------------------------------
# Neo4j（可选，memory-service 图存储；不启用则关系走 PostgreSQL 邻接表）
# -----------------------------------------------------------------------------
GRAPH_BACKEND=none               # none | neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Kafka —— 事件总线（与 OCTO 侧 octo-search-indexer 共用集群）
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
# 消费：OCTO 侧事件
KAFKA_TOPIC_OCTO_MESSAGES=octo.message.created
KAFKA_TOPIC_OCTO_FILES=octo.file.uploaded
# 生产：自研组件事件
KAFKA_TOPIC_DOC_INGEST=aios.document.ingest
KAFKA_TOPIC_DOC_INDEXED=aios.document.indexed
KAFKA_TOPIC_MEMORY_WRITE=aios.memory.write
KAFKA_TOPIC_MEETING_ACTIONS=aios.meeting.actions
KAFKA_CONSUMER_GROUP_PREFIX=aios

# -----------------------------------------------------------------------------
# MinIO / S3 —— 原始文档、音频、转录文本
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aios-minio
S3_SECRET_KEY=change-me-in-production
S3_BUCKET_DOCUMENTS=aios-documents
S3_BUCKET_MEDIA=aios-media
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# model-gateway —— 上游模型厂商凭证
# 只在 model-gateway 容器中注入，其余服务不应持有厂商 Key
# -----------------------------------------------------------------------------
# 阿里云百炼 / Qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 智谱 GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 零一万物 Yi
YI_API_KEY=
YI_BASE_URL=https://api.lingyiwanwu.com/v1
# 私有化 vLLM（可选）
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_API_KEY=not-needed

# -----------------------------------------------------------------------------
# 内部服务地址（服务间调用，容器网络内）
# -----------------------------------------------------------------------------
MODEL_GATEWAY_URL=http://model-gateway:8200
RAG_PIPELINE_URL=http://rag-pipeline:8100
WORKFLOW_ENGINE_URL=http://workflow-engine:8300
MEMORY_SERVICE_URL=http://memory-service:8400
MEETING_AGENT_URL=http://meeting-agent:8500
# 内部服务间共享密钥（S2S 调用鉴权，非用户身份）
INTERNAL_SERVICE_TOKEN=change-me-internal-s2s-token

# -----------------------------------------------------------------------------
# OCTO 生态对接
# -----------------------------------------------------------------------------
OCTO_SERVER_BASE_URL=http://octo-server:5001
OCTO_AUTH_BASE_URL=http://octo-auth:8080
OCTO_AUTH_ENABLED=true
# 自研服务注册为 OCTO Bot 时使用
OCTO_BOT_TOKEN=
OCTO_WS_URL=ws://octo-im:5200
# 依赖的 OCTO 微服务
OCTO_SPEECH_URL=http://octo-speech:8090          # ASR，meeting-agent 复用
OCTO_MATTER_URL=http://octo-matter:8091          # 任务/待办，行动项落库
OCTO_SEARCH_INDEXER_URL=http://octo-search-indexer:8092   # BM25 全文，混合检索用
OCTO_ADAPTERS_URL=http://octo-adapters:3000      # 飞书/Slack 分发

# -----------------------------------------------------------------------------
# rag-pipeline
# -----------------------------------------------------------------------------
RAG_PORT=8100
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIM=1024
RAG_RERANK_MODEL=bge-reranker-v2-m3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=20
RAG_RERANK_TOP_N=5
RAG_HYBRID_ALPHA=0.5             # 0=纯 BM25, 1=纯向量
RAG_INGEST_CONCURRENCY=4

# -----------------------------------------------------------------------------
# memory-service
# -----------------------------------------------------------------------------
MEMORY_PORT=8400
MEMORY_EXTRACTION_MODEL=qwen-plus
MEMORY_DECAY_HALFLIFE_DAYS=90
MEMORY_CONSOLIDATION_CRON=0 3 * * *
MEMORY_MAX_PER_SCOPE=10000

# -----------------------------------------------------------------------------
# workflow-engine
# -----------------------------------------------------------------------------
WORKFLOW_PORT=8300
WORKFLOW_MAX_CONCURRENT_RUNS=100
WORKFLOW_WORKER_POOL_SIZE=16
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=3600
WORKFLOW_APPROVAL_TIMEOUT_SECONDS=86400

# -----------------------------------------------------------------------------
# meeting-agent
# -----------------------------------------------------------------------------
MEETING_PORT=8500
MEETING_ASR_PROVIDER=octo-speech # octo-speech | whisper | sensevoice
MEETING_ASR_LANGUAGE=zh
MEETING_SUMMARY_MODEL=deepseek-chat
MEETING_DIARIZATION_ENABLED=true
MEETING_MAX_AUDIO_MB=500

# -----------------------------------------------------------------------------
# 可观测性（OCTO 侧已有 OTel 采集，这里只配上报地址）
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=enterprise-ai-os
