# Normalize text files on commit; store LF in the repository regardless of OS.
* text=auto eol=lf

# Binary assets - never EOL-converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.tar.gz binary
*.zip binary

# Windows scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
